<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane prefHeight="720.0" prefWidth="1280.0"
      style="-fx-background-color: rgba(0,0,0,0.7);"
      xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookify.Controller.PopupPagamentoController">

    <children>

        <!-- CAIXA DO MODAL -->
        <Pane layoutX="390.0" layoutY="160.0"
              prefHeight="400.0" prefWidth="500.0"
              style="-fx-background-color: #EEEEEE; -fx-background-radius: 20px;"
              stylesheets="@styles.css">

            <children>

                <!-- TÍTULO -->
                <Text layoutX="150.0" layoutY="45.0" text="EFETUAR PAGAMENTO">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                </Text>

                <!-- BOTÕES DE MÉTODO -->
                <HBox layoutX="60.0" layoutY="80.0" spacing="20.0">

                    <Button fx:id="pixBtn"
                            mnemonicParsing="false"
                            onAction="#selecionarPix"
                            prefHeight="45.0"
                            prefWidth="160.0"
                            styleClass="renovar-style"
                            text="PIX"
                            textFill="WHITE">
                        <font>
                            <Font size="18.0"/>
                        </font>
                    </Button>

                    <Button fx:id="boletoBtn"
                            mnemonicParsing="false"
                            onAction="#selecionarBoleto"
                            prefHeight="45.0"
                            prefWidth="160.0"
                            styleClass="renovar-style"
                            text="BOLETO"
                            textFill="WHITE">
                        <font>
                            <Font size="18.0"/>
                        </font>
                    </Button>

                </HBox>

                <!-- CONTEÚDO DINÂMICO -->
                <VBox fx:id="conteudoBox"
                      layoutX="90.0"
                      layoutY="150.0"
                      prefWidth="320.0"
                      spacing="15.0"
                      alignment="CENTER">

                    <!-- QR CODE PIX -->
                    <ImageView fx:id="qrCodeImage"
                               fitHeight="180.0"
                               fitWidth="180.0"
                               preserveRatio="true"
                               visible="false"/>

                    <!-- TEXTO BOLETO -->
                    <Text fx:id="boletoInfoText"
                          text="Clique no botão abaixo para baixar o boleto"
                          visible="false"
                          wrappingWidth="300.0">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Text>

                    <!-- BOTÃO BAIXAR -->
                    <Button fx:id="baixarBoletoBtn"
                            mnemonicParsing="false"
                            onAction="#baixarBoleto"
                            prefHeight="40.0"
                            prefWidth="200.0"
                            styleClass="renovar-style"
                            text="BAIXAR BOLETO"
                            textFill="WHITE"
                            visible="false">
                        <font>
                            <Font size="16.0"/>
                        </font>
                    </Button>

                </VBox>

                <!-- FECHAR -->
                <Button layoutX="460.0"
                        layoutY="10.0"
                        mnemonicParsing="false"
                        onAction="#fechar"
                        styleClass="botao-redondo"
                        stylesheets="@styles.css"/>

            </children>
        </Pane>
    </children>
</Pane>
